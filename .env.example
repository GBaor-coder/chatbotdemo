# =========================
# PostgreSQL (local dev)
# =========================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chatbot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
PGVECTOR_DIM=1024

# =========================
# AI Service (Python FastAPI RAG Data Service)
# Chỉ embedding, ingestion, retrieval. KHÔNG gọi LLM.
# =========================
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
# Khóa service-to-service .NET -> Python (đặt giá trị thật, không để mặc định)
X_INTERNAL_API_KEY=change-me-internal-key
LOG_LEVEL=INFO

# =========================
# Backend .NET (Gateway & Orchestration)
# =========================
ConnectionStrings__Default=Host=db;Port=5432;Database=chatbot;Username=postgres;Password=postgres
PYTHON_RAG_URL=http://ai-service:8000
# LLM_API_KEY đọc từ .env, KHÔNG commit plaintext vào repo. Key cũ đã lộ → phải thu hồi và cấp mới.
LLM_API_KEY=sk-*******
LLM_BASE_URL=http://host.docker.internal:20128/v1
LLM_MODEL=ag/claude-sonnet-4-6
# Cấu hình theo tenant (ví dụ, điền giá trị thật)
GUARDRAIL_REFUSAL_MESSAGE=Xin lỗi, hiện tại tôi chỉ hỗ trợ giải đáp các thông tin liên quan đến tuyển sinh của Nhà trường dựa trên dữ liệu chính thức. Bạn vui lòng đặt câu hỏi về ngành học, điểm chuẩn, học phí hoặc phương thức xét tuyển nhé!
GUARDRAIL_MIN_SCORE=0.45
DEFAULT_TENANT_ID=11111111-1111-1111-1111-111111111111
ASPNETCORE_URLS=http://+:5000
APP_ENV=development
